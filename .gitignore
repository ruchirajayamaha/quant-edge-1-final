# Virtual environments
.venv/
venv/
ENV/

# Python bytecode and build artifacts
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
build/
dist/
.eggs/

# Testing and tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Secrets and local environment overrides
.env
.env.*
*.secret*

# Temporary scratch directory (preserved locally, excluded from commits)
tmp/

# OS metadata
.DS_Store
Thumbs.db

# TeX intermediates and the superseded ReportLab output
report/latex/**/*.aux
report/latex/**/*.log
report/latex/**/*.out
report/latex/**/*.toc
report/latex/**/*.bbl
report/latex/**/*.blg
report/latex/**/*.xdv
report/latex/**/*.fls
report/latex/**/*.fdb_latexmk
output/legacy_reportlab/

# Local audit runtime caches; retain the actual audit reports and evidence
audit/**/yfinance_cache/
audit/**/pytest_temp*/
audit/**/pytest_*_temp/
